# Copy to .env and fill only the values you need. Never commit .env.
HF_TOKEN=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
WANDB_API_KEY=

# Persistent volume paths on the remote GPU. Confirm the mount with Cambria.
ROLE_PROBE_STORAGE_ROOT=/workspace/role-probe-storage
HF_HOME=/workspace/role-probe-storage/huggingface
ROLE_PROBE_OUTPUT_DIR=/workspace/role-probe-storage/outputs
ROLE_PROBE_MODEL_REVISION=6cee5e81ee83917806bbde320786a8fb61efebee
ROLE_PROBE_C4_REVISION=f3b95a11ff318ce8b651afc7eb8e7bd2af469c10

# Baseline paper-demo values. Use 10 and 1 for the first H100 smoke test.
ROLE_PROBE_N_SAMPLES=150
ROLE_PROBE_BATCH_SIZE=32
ROLE_PROBE_MAX_SEQLEN=512

# `prompt_ix` reproduces the demo's split. `base_seq_ix` prevents identical
# source content from appearing across train/test and is the robustness check.
ROLE_PROBE_SPLIT_GROUP=prompt_ix
